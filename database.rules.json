{
  "rules": {
    "usuarios": {
      ".read": "auth != null && (auth.uid == 'xkSkF0DVSGfJuJlNA5vpqiAfVQ92')",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.uid == 'xkSkF0DVSGfJuJlNA5vpqiAfVQ92')",
        ".write": "auth != null && ((auth.uid == 'xkSkF0DVSGfJuJlNA5vpqiAfVQ92') || auth.uid == $uid)",
        ".validate": "(auth.uid == 'xkSkF0DVSGfJuJlNA5vpqiAfVQ92') || ((!data.exists() && newData.child('rol').val() == 'usuario') || (data.exists() && newData.child('rol').val() == data.child('rol').val()))",
        "email": {
          ".validate": "newData.isString() && newData.val().matches(/^[^@]+@[^@]+\\./)"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "rol": {
          ".validate": "newData.val() == 'admin' || newData.val() == 'usuario'"
        },
        "activo": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
